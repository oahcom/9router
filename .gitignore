package-lock.json


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
README1.md
deploy*.sh
ecosystem.config.*

scripts/agSniffer/*
gitbooks/*
gitbook/README.md

# Refactor backup reference (do not bundle/lint)
open-sse.old/
.graphifyignore
graphify-out/*

# Local-only working dirs (notes, vendored repos, scripts, skills)
.claude/
.docs/
.repo/
.script/
.codegraph/
.PR/
.next-analyze/*

# Kiro local workspace state
.kiro/
9router-*

# Local sensitive / temp files
.engine-token.txt
.tmp-prov.json
.tmp-providers.json
.oauth-session.json
.dev-server.log
.dev-server-err.log
.start-dev.ps1
start-dev-silent.cjs
debug.log
# 运行时文件
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
runtime/
proxy-global.disabled

# Node
node_modules/

# 系统
.DS_Store
*.swp
*~
.scratch/

# Runtime state: written on every request, must not live in git history
/db/*.sqlite
/db/*.sqlite-shm
/db/*.sqlite-wal
/db/*.bak-*
# Crash/cleanup leftovers keep the original name plus a suffix, e.g.
# "data.sqlite (deleted)", which the .sqlite rules above do not match.
/db/*.sqlite *
/model-catalog.json
/model-catalog-raw.json
/.next.stale-*/
/build-*.log

# Generated on first run with mode 0600 — never belongs in git.
# jwt-secret signs the dashboard session cookie; cli-secret is the salt for the
# x-9r-cli-token derivation (sha256(machine-id + '9r-cli-auth' + cli-secret)).
jwt-secret
auth/cli-secret
machine-id
.vitest-report.json

# 手工备份 / 编辑器残留不许进仓库（opencode.js.bak-20261030-0125 教训）
*.bak-*
*.bak
